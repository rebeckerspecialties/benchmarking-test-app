{
  "name": "benchmarking-test-app",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "build:android": "npm run mkdist && react-native bundle --entry-file index.js --platform android --dev true --bundle-output dist/main.android.jsbundle --assets-dest dist/res --sourcemap-output ./dist/sourceMap.js",
    "build:ios": "npm run mkdist && react-native bundle --entry-file index.js --platform ios --dev true --bundle-output dist/main.ios.jsbundle --assets-dest dist",
    "build:ios:release": "npm run mkdist && react-native bundle --entry-file index.js --platform ios --dev false --bundle-output dist/main.ios.jsbundle --assets-dest dist",
    "ios": "react-native run-ios",
    "lint": "eslint src/ App.tsx",
    "mkdist": "node -e \"require('node:fs').mkdirSync('dist', { recursive: true, mode: 0o755 })\"",
    "start": "react-native start",
    "test": "jest",
    "install:hermes": "npm install && npm install react-native-release-profiler@^0.2.1 && node ../../scripts/set-runtime.js hermes",
    "install:jsc": "npm install && npm uninstall react-native-release-profiler && npm install ../../packages/react-native-release-profiler && node ../../scripts/set-runtime.js jsc",
    "install:ios:hermes": "(export USE_HERMES=1 USE_THIRD_PARTY_JSC=0; pod install --project-directory=ios)",
    "install:ios:jsc": "(export USE_HERMES=0 USE_THIRD_PARTY_JSC=1; pod install --project-directory=ios)",
    "download-profiles": "ios-deploy --download=/Library/Caches --bundle_id com.rbckr.TestApp -2 ."
  },
  "dependencies": {
    "@callstack/react-native-visionos": "^0.79.6",
    "@react-native-community/javascriptcore": "^0.2.0",
    "bitecs": "^0.3.40",
    "events": "^3.3.0",
    "node-cache": "^5.1.2",
    "node-schedule": "^2.1.1",
    "react": "19.1.1",
    "react-native": "^0.82.1",
    "react-native-benchmarking-library": "1.0.0",
    "react-native-get-random-values": "^1.11.0",
    "react-native-permissions": "^5.4.4",
    "react-native-release-profiler": "^0.4.2",
    "react-native-wgpu": "^0.3.2",
    "three": "0.181.0",
    "wgpu-matrix": "^3.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.3",
    "@babel/preset-env": "^7.26.3",
    "@babel/runtime": "^7.26.3",
    "@eslint/compat": "^1.4.1",
    "@eslint/js": "^9.39.0",
    "@expo/config-plugins": "^54.0.2",
    "@react-native/babel-preset": "^0.82.1",
    "@react-native/eslint-config": "^0.82.1",
    "@react-native/metro-config": "^0.82.1",
    "@react-native/typescript-config": "^0.82.1",
    "@rnx-kit/metro-config": "^2.1.2",
    "@types/react": "^19.2.2",
    "@types/react-native-get-random-values": "^1.8.2",
    "@types/react-test-renderer": "^19.1.0",
    "@types/three": "^0.181.0",
    "@webgpu/types": "^0.1.66",
    "babel-jest": "^29.7.0",
    "eslint": "^9.39.0",
    "eslint-config-react-native-wcandillon": "^4.0.1",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "prettier": "3.3.3",
    "react-native-test-app": "^5.0.0",
    "react-test-renderer": "19.1.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.46.2"
  },
  "engines": {
    "node": ">=18"
  }
}
