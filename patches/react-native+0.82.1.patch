@@ -46,9 +46,27 @@ Pod::Spec.new do |s|
 
   # This guard prevent to install the dependencies when we run `pod install` in the old architecture.
   s.compiler_flags = other_cflags
+
+  # PATCH: Add GCC_PREPROCESSOR_DEFINITIONS for JSC support
+  # This ensures USE_HERMES and USE_THIRD_PARTY_JSC flags are available in header files
+  # Required for proper conditional compilation of Hermes vs JSC code paths
+  # See: https://github.com/facebook/react-native/commit/69826e1f11737e973149a4d90981ad57238e6ca1
+  preprocessor_defs = "$(inherited) COCOAPODS=1"
+  if ENV['RCT_NEW_ARCH_ENABLED'] != "0"
+    preprocessor_defs += " RCT_NEW_ARCH_ENABLED=1"
+  end
+  if use_hermes()
+    preprocessor_defs += " USE_HERMES=1"
+  elsif use_third_party_jsc()
+    preprocessor_defs += " USE_THIRD_PARTY_JSC=1 USE_HERMES=0"
+  else
+    preprocessor_defs += " USE_HERMES=0"
+  end
+
   s.pod_target_xcconfig    = {
     "HEADER_SEARCH_PATHS" => header_search_paths,
     "OTHER_CPLUSPLUSFLAGS" => other_cflags,
+    "GCC_PREPROCESSOR_DEFINITIONS" => preprocessor_defs,
     "CLANG_CXX_LANGUAGE_STANDARD" => rct_cxx_language_standard(),
     "DEFINES_MODULE" => "YES"
   }
